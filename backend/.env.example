# --- Application ---
APP_ENV=local
# Used for HMAC phone hashing and general signing. Generate a strong random value in real envs.
APP_SECRET_KEY=dev-secret-change-me-0123456789abcdef
SESSION_TOKEN_TTL_DAYS=30

# --- Database ---
# Local default uses a SQLite file so the project runs with zero external services.
# For Postgres (the production target), use e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/believablecall
DATABASE_URL=sqlite+pysqlite:///./believablecall.db

# --- Phone encryption ---
# Fernet key (urlsafe base64, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, one is derived deterministically from APP_SECRET_KEY (dev only).
PHONE_ENCRYPTION_KEY=

# --- Providers (mock by default; no external account required) ---
OTP_PROVIDER=mock
VOICE_PROVIDER=mock
MESSAGE_PROVIDER=mock

# --- Feature flags ---
FEATURE_FREE_TEST_REQUEST=true
FREE_TEST_CREDITS=3
# Max request-create calls per user per hour (prod default 5; raise in dev).
REQUEST_CREATE_MAX_PER_HOUR=5
SUPPORTED_COUNTRIES=DE,US,GB,AT,CH

# --- Optional / later (real providers) ---
#
# To use real Twilio Verify for OTP (SMS codes to real phones):
#   1. Create/log into a Twilio account: https://www.twilio.com/try-twilio
#   2. Console > Account > Account SID / Auth Token -> TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
#   3. Console > Verify > Services > Create new Service -> TWILIO_VERIFY_SERVICE_SID (starts "VA")
#   4. Set OTP_PROVIDER=twilio_verify above (mock stays the default for tests).
#   Trial accounts can only send to phone numbers you've verified in the console.
#
# To use real Twilio Messaging for SMS:
#   1. Same TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN as above.
#   2. Get a sender, one of:
#        - Console > Messaging > Services > create a Service -> TWILIO_MESSAGING_SERVICE_SID ("MG...")
#        - or buy/keep an SMS-capable number -> TWILIO_SMS_FROM_NUMBER (E.164, e.g. +18885550000)
#   3. Set MESSAGE_PROVIDER=twilio_messaging above (mock stays the default for tests).
#   4. (Optional) For delivery status -> "Completed": expose this app publicly
#      (e.g. ngrok) and set TWILIO_STATUS_CALLBACK_URL to <public-url>/v1/webhooks/sms.
#   Trial accounts can only text numbers you've verified in the console.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM_NUMBER=
# TWILIO_STATUS_CALLBACK_URL=
#
# To use real Vapi for voice calls:
#   1. Create a Vapi account: https://dashboard.vapi.ai
#   2. Account > API Keys -> VAPI_API_KEY (private key).
#   3. Assistants > create one (voice + system prompt) -> VAPI_ASSISTANT_ID.
#   4. Phone Numbers > import/buy a number to call FROM -> VAPI_PHONE_NUMBER_ID.
#   5. Set VOICE_PROVIDER=vapi above (mock stays the default for tests).
#   6. (Optional) Set a Server URL = <public-url>/v1/webhooks/voice and a
#      Server URL Secret -> VAPI_WEBHOOK_SECRET (Vapi echoes it as X-Vapi-Secret).
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# REVENUECAT_WEBHOOK_SECRET=
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Application ---
APP_ENV=local
# Used for HMAC phone hashing and general signing. Generate a strong random value in real envs.
APP_SECRET_KEY=dev-secret-change-me-0123456789abcdef
SESSION_TOKEN_TTL_DAYS=30

# --- Database ---
# Local default uses a SQLite file so the project runs with zero external services.
# For Postgres (the production target), use e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/believablecall
DATABASE_URL=sqlite+pysqlite:///./believablecall.db

# --- Phone encryption ---
# Fernet key (urlsafe base64, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, one is derived deterministically from APP_SECRET_KEY (dev only).
PHONE_ENCRYPTION_KEY=

# --- Providers (mock by default; no external account required) ---
OTP_PROVIDER=mock
VOICE_PROVIDER=mock
MESSAGE_PROVIDER=mock

# --- Feature flags ---
FEATURE_FREE_TEST_REQUEST=true
# Starter credits for a new phone number (once per number, also after deletion).
FREE_TEST_CREDITS=4
# Credits per request. See docs/pricing.md.
CALL_CREDIT_COST=4
SMS_CREDIT_COST=1
# Calls to another country than the sender line's end before a second billed minute.
CROSS_BORDER_CALL_MAX_SECONDS=55
# Max request-create calls per user per hour (prod default 5; raise in dev).
REQUEST_CREATE_MAX_PER_HOUR=5
SUPPORTED_COUNTRIES=DE,US,GB,AT,CH

# --- Optional / later (real providers) ---
#
# To use real Twilio Verify for OTP (SMS codes to real phones):
#   1. Create/log into a Twilio account: https://www.twilio.com/try-twilio
#   2. Console > Account > Account SID / Auth Token -> TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
#   3. Console > Verify > Services > Create new Service -> TWILIO_VERIFY_SERVICE_SID (starts "VA")
#   4. Set OTP_PROVIDER=twilio_verify above (mock stays the default for tests).
#   Trial accounts can only send to phone numbers you've verified in the console.
#
# To use real Twilio Messaging for SMS:
#   1. Same TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN as above.
#   2. Get a sender, one of:
#        - Console > Messaging > Services > create a Service -> TWILIO_MESSAGING_SERVICE_SID ("MG...")
#        - or buy/keep an SMS-capable number -> TWILIO_SMS_FROM_NUMBER (E.164, e.g. +18885550000)
#   3. Set MESSAGE_PROVIDER=twilio_messaging above (mock stays the default for tests).
#   4. (Optional) For delivery status -> "Completed": expose this app publicly
#      (e.g. ngrok) and set TWILIO_STATUS_CALLBACK_URL to <public-url>/v1/webhooks/sms.
#   Trial accounts can only text numbers you've verified in the console.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM_NUMBER=
# TWILIO_STATUS_CALLBACK_URL=
#
# To use real Vapi for voice calls:
#   The agent (prompt, model, voice, transcriber) lives in app/agent and goes to
#   Vapi with every call, so there is no assistant to set up in the dashboard.
#   1. Create a Vapi account: https://dashboard.vapi.ai
#   2. Account > API Keys -> VAPI_API_KEY (private key).
#   3. Link the Twilio numbers: `make sync-senders-vapi` imports every voice-capable
#      Twilio line into Vapi and stores its id, so calls come from the same number
#      as that persona's texts. VAPI_PHONE_NUMBER_ID is only a fallback line.
#   4. Expose this API publicly and set PUBLIC_BASE_URL (Vapi posts call events to
#      <PUBLIC_BASE_URL>/v1/webhooks/voice) and a random VAPI_WEBHOOK_SECRET.
#   5. Set VOICE_PROVIDER=vapi above (mock stays the default for tests).
#   6. Vapi bills the model and voice through your Vapi account unless you add
#      your own OpenAI / ElevenLabs keys under Vapi > Provider Keys.
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# PUBLIC_BASE_URL=https://api.example.com
#
# Voice agent (defaults shown; voice ids are ElevenLabs stock voices for now).
# AGENT_LLM_PROVIDER=openai
# AGENT_LLM_MODEL=gpt-4o
# AGENT_LLM_TEMPERATURE=0.8
# AGENT_LLM_MAX_TOKENS=120
# AGENT_VOICE_PROVIDER=11labs
# AGENT_VOICE_MODEL=eleven_multilingual_v2
# AGENT_VOICE_ID_WARM=EXAVITQu4vr4xnSDxMaL
# AGENT_VOICE_ID_NEUTRAL=21m00Tcm4TlvDq8ikWAM
# AGENT_TRANSCRIBER_PROVIDER=deepgram
# AGENT_TRANSCRIBER_MODEL=nova-3
#
# Eval harness (`make eval`). mock runs offline; openai/anthropic need a key.
# EVAL_LLM_PROVIDER=mock
# EVAL_LLM_MODEL=gpt-4o
# EVAL_JUDGE_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# In-app purchases (credit packs are consumable App Store products).
#   mock: the app's mock purchases (mock:<product>:<id>) are accepted. Refused
#         when APP_ENV=production.
#   app_store: pip install -e ".[appstore]", download Apple's root certificates
#         (https://www.apple.com/certificateauthority/, the .cer files) into a
#         folder, and set the values below. In App Store Connect, point the
#         Server Notifications V2 URL at <PUBLIC_BASE_URL>/v1/webhooks/app-store
#         so refunds take the credits back.
# STORE_VERIFIER=mock
# APP_STORE_BUNDLE_ID=com.believablecall.app
# APP_STORE_APP_APPLE_ID=
# APP_STORE_ENVIRONMENT=Sandbox
# APP_STORE_ROOT_CERTS_DIR=
# REVENUECAT_WEBHOOK_SECRET=
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

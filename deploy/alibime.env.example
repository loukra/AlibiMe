# Production settings for the server. Copy to /opt/alibime/backend/.env,
# chmod 600, owned by alibime. The API refuses to start while anything here
# still points at a mock or a dev secret (app/core/config.py, assert_deployable).
# Every key comes from the provider's dashboard; none of them belong in git.

APP_ENV=production
APP_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(48))"
PHONE_ENCRYPTION_KEY=      # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=postgresql+psycopg://alibime@/alibime   # local socket, peer auth
PUBLIC_BASE_URL=https://api.alibime.example

# Twilio: OTP, texts, the caller lines
OTP_PROVIDER=twilio_verify
MESSAGE_PROVIDER=twilio_messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=https://api.alibime.example/v1/webhooks/sms

# Vapi: the voice agent
VOICE_PROVIDER=vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=       # random; the same value goes into Vapi

# App Store purchases
STORE_VERIFIER=app_store
APP_STORE_BUNDLE_ID=com.believablecall.app
APP_STORE_APP_APPLE_ID=    # App Store Connect, App Information, Apple ID
APP_STORE_ENVIRONMENT=Production   # Sandbox while testing with TestFlight or a sandbox account
APP_STORE_ROOT_CERTS_DIR=/opt/alibime/secrets/apple-root-certs

# Free credits once per iPhone
DEVICE_CHECK=apple
DEVICE_CHECK_TEAM_ID=
DEVICE_CHECK_KEY_ID=
DEVICE_CHECK_PRIVATE_KEY_PATH=/opt/alibime/secrets/AuthKey_DEVICECHECK.p8
DEVICE_CHECK_ENVIRONMENT=production   # development only for builds run from Xcode

# Sign-in for Apple's App Review (put both in the review notes). No SMS is
# sent; the code must be at least 8 digits. Calls and texts go to this number,
# so use one you hold. Leave both empty to turn it off.
REVIEW_PHONE_NUMBER=
REVIEW_OTP_CODE=
REVIEW_CREDITS=10

# Credits and limits (see docs/pricing.md)
FREE_TEST_CREDITS=3
CALL_CREDIT_COST=2
SMS_CREDIT_COST=1
FIRST_PURCHASE_BONUS_CREDITS=3
CROSS_BORDER_CALL_MAX_SECONDS=55
REQUEST_CREATE_MAX_PER_HOUR=5

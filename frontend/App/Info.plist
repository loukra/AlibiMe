<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow the app to reach the local dev backend over http://127.0.0.1. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Requested only in-context, when the user chooses to save a sender as a
	     contact. The app never asks for Contacts access at launch. -->
	<key>NSContactsUsageDescription</key>
	<string>Save a sender as a contact, like "Mom", so your alibi rings or arrives as someone you know. This is optional — alibis work whether or not you save a contact.</string>
</dict>
</plist>
